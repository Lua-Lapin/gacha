{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "gacha-gallery",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "gacha.lun222.com", "custom_domain": true }],
  "assets": { "directory": "./dist" },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "gacha-gallery" }]
}
